// Cloudflare deploy of the Oradea build: a Worker with static assets only (no server code). `npm run deploy:oradea`
// builds dist/ with VITE_CITY=oradea and uploads it. Limits: 25 MiB per file, 20,000 files (free plan).
{
  "name": "oradea-drive",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./dist" },
  // the public address under the organiser's domain (zone drumulvietii.ro on this account); workers.dev keeps working
  "routes": [{ "pattern": "oradea.drumulvietii.ro", "custom_domain": true }],
  "workers_dev": true
}
